// Fluid: plain fastfetch, the Arch logo in the theme's accent.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "color": { "1": "38;2;215;229;155", "2": "38;2;215;229;155" }, "padding": { "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;215;229;155", "title": "38;2;215;229;155", "output": "38;2;227;228;218" }
  },
  "modules": ["title", "separator", "os", "kernel", "uptime", { "type": "packages", "format": "{pacman} pacman, {flatpak-all} flatpak, {appimage} appimage" }, "shell", "wm", "terminal",
              "cpu", { "type": "gpu", "format": "{name}" }, "memory", "disk", "break", "colors"]
}
