// One Dark: plain fastfetch, the Arch logo in the theme's accent.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "color": { "1": "38;2;97;175;239", "2": "38;2;97;175;239" }, "padding": { "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;97;175;239", "title": "38;2;97;175;239", "output": "38;2;171;178;191" }
  },
  "modules": ["title", "separator", "os", "kernel", "uptime", "packages", "shell", "wm", "terminal",
              "cpu", "gpu", "memory", "disk", "break", "colors"]
}
