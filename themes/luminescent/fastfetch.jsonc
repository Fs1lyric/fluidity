// Luminescent: plain fastfetch, the Arch logo in Catppuccin teal, mauve keys.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "color": { "1": "38;2;148;226;213", "2": "38;2;148;226;213" }, "padding": { "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;203;166;247", "title": "38;2;180;190;254", "output": "38;2;205;214;244" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
