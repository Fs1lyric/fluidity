// Simple: plain fastfetch, the Arch logo in the theme's accent.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch", "color": { "1": "38;2;231;248;22", "2": "38;2;231;248;22" }, "padding": { "right": 3 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;231;248;22", "title": "38;2;231;248;22", "output": "38;2;240;247;216" }
  },
  "modules": ["title", "separator", "os", "kernel", "uptime", "packages", "shell", "wm", "terminal",
              "cpu", "gpu", "memory", "disk", "break", "colors"]
}
