#!/usr/bin/env bash
# The scratch terminal: a floating terminal on the workspace you are on. Never a hidden special workspace.
#   fluidity-scratch toggle   open it here, bring it here, or close it if it is focused
#   fluidity-scratch take     make the focused window float and pin like the scratch one
cls=fluidity.scratch
dsp() { hyprctl dispatch "$1" >/dev/null; }
case ${1:-toggle} in
  toggle)
    win=$(hyprctl clients -j | jq -c --arg c "$cls" '[.[] | select(.class == $c)][0] // empty')
    if [[ -z $win ]]; then exec fluidity-launch tui --app-id=$cls bash; fi
    addr=$(jq -r .address <<<"$win")
    if [[ $(hyprctl activewindow -j | jq -r .address) == "$addr" ]]; then dsp "hl.dsp.window.close({ window = \"address:$addr\" })"; exit; fi
    ws=$(hyprctl activeworkspace -j | jq -r .id)
    dsp "hl.dsp.window.move({ window = \"address:$addr\", workspace = \"$ws\" })"
    dsp "hl.dsp.focus({ window = \"address:$addr\" })" ;;
  take) exec fluidity-window pop ;;
  *) sed -n '3,4s/^# \?//p' "$0" >&2; exit 1 ;;
esac
