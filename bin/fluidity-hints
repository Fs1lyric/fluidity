#!/usr/bin/env bash
# Click hints: a label on everything clickable; type it to click there (wl-kbptr, styled by the theme).
command -v wl-kbptr >/dev/null || { notify-send -u low -a Fluidity "Click hints need wl-kbptr" "fluidity-install wl-kbptr"; exit 1; }
pkill -x wl-kbptr && exit 0
exec wl-kbptr -o modes=tile,click "$@"
