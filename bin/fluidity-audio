#!/usr/bin/env bash
# fluidity-audio next-output: move sound to the next output device (PipeWire), and say which.
[[ ${1:-} == next-output ]] || { echo "usage: fluidity-audio next-output" >&2; exit 1; }
mapfile -t ids < <(pactl -f json list sinks 2>/dev/null | jq -r '.[] | select(.ports | length == 0 or any(.availability != "not available")) | .name')
((${#ids[@]})) || exit 1
cur=$(pactl get-default-sink); next=${ids[0]}
for i in "${!ids[@]}"; do [[ ${ids[i]} == "$cur" ]] && next=${ids[(i + 1) % ${#ids[@]}]}; done
pactl set-default-sink "$next"
desc=$(pactl -f json list sinks | jq -r --arg n "$next" '.[] | select(.name == $n) | .description')
qs -c fluidity ipc call island notify "Sound output" "$desc" >/dev/null 2>&1 || notify-send -u low -a Fluidity "Sound output" "$desc"
